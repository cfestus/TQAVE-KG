etd:question-16 a etd:Question ;
    rdfs:label "What are the ethical issues of matching algorithms?" ;
    etd:authoredBy etd:expert-36 ;
    etd:belongsToTheme etd:theme-10 ;
    etd:body "In recruitment, algorithms are used to do the parsing of resumes, and to score the matching with a job offer. What are the ethical issues I need to take care of ?" ;
