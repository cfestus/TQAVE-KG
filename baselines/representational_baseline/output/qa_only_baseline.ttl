etd:answer-13 a etd:Answer ;
    rdfs:label "Automation bias - how to avoid a situation in which recruiters over-rely on the" ;
    etd:answerId 13 ;
    etd:answersQuestion etd:question-16 ;
    etd:authoredBy etd:expert-19 ;
    etd:created_at "2025-07-22T10:04:53.540000+00:00"^^xsd:dateTime ;
    etd:description """Automation bias - how to avoid a situation in which recruiters over-rely on the outputs of such systems? How do we ensure that their autonomy to make decisions is not affected? \r
\r
For example the Assessment List for Trustworthy AI asks "Could the AI system affect human autonomy by generating over-reliance by end-users?" ? \r
\r
How do we make sure that the decision made by the system are understandable and explainable to the applicants and recruiters?""" ;
    etd:expertId 19 ;
    etd:hasVote etd:vote-64,
        etd:vote-66,
        etd:vote-67 ;
    etd:questionId 16 .

etd:answer-15 a etd:Answer ;
    rdfs:label "Kate Crawford and Trevor Paglen, “Excavating AI: The Politics of Training Sets f" ;
    etd:answerId 15 ;
    etd:answersQuestion etd:question-18 ;
    etd:authoredBy etd:expert-19 ;
    etd:created_at "2025-07-22T14:29:49.437000+00:00"^^xsd:dateTime ;
    etd:description "Kate Crawford and Trevor Paglen, “Excavating AI: The Politics of Training Sets for Machine Learning (September 19, 2019) https://excavating.ai" ;
    etd:expertId 19 ;
