etd:Impact a owl:Class ;
    rdfs:label "Broader societal or systemic effect"@en ;
    rdfs:comment "Broader societal, organisational, or user-level consequence linked to AI use or governance decisions."@en ;
    rdfs:subClassOf etd:Entity,
        airo:Risk .

etd:ResearchOutput a owl:Class ;
    rdfs:label "Research output"@en ;
    rdfs:comment "Umbrella class for a work-product of research activity (a study, an analysis, or a publication reporting findings) -- distinct from Dataset, which is the underlying data resource a ResearchOutput may describe, use, or report on."@en ;
    rdfs:subClassOf etd:Resource .

