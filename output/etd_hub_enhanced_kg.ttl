@prefix aipo: <https://w3id.org/aipo#> .
@prefix airo: <https://w3id.org/airo#> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix etd: <https://alfie-project.eu/etd-hub#> .
@prefix fmo: <http://purl.org/fairness-metrics-ontology/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix sioc: <http://rdfs.org/sioc/ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vair: <https://w3id.org/vair#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

etd:Action a owl:Class ;
    rdfs:label "Specific system or organizational action"@en ;
    rdfs:comment "ETD class representing action concepts in the semantic knowledge graph."@en ;
    rdfs:subClassOf etd:Entity .

etd:Algorithm a owl:Class ;
    rdfs:label "Algorithm"@en ;
    rdfs:comment "ETD proxy class materialised during ontology alignment; used to preserve stable local typing."@en ;
    rdfs:subClassOf aipo:AISystem .

etd:Analysis a owl:Class ;
    rdfs:label "Analysis"@en ;
    rdfs:comment "A specific analytical or evaluative pass applied to existing data or a dataset (e.g. 'analysis of the HMDA dataset revealed...'), narrower in scope than a full ResearchStudy and not itself a data resource."@en ;
    rdfs:subClassOf dcat:Dataset,
        etd:ResearchOutput .

etd:Audit a owl:Class ;
    rdfs:label "Audit"@en ;
    rdfs:comment "ETD proxy class materialised during ontology alignment; used to preserve stable local typing."@en ;
    rdfs:subClassOf aipo:AssessmentProcedure .

etd:AuditProcess a owl:Class ;
    rdfs:label "Audit process"@en ;
    rdfs:comment "A systematic, typically formalised assessment or audit activity applied to an AI system, dataset, or organisational practice to check compliance, quality, or fairness. A specific kind of Evaluation; use Evaluation itself for assessment activity that is not specifically audit-shaped."@en ;
    rdfs:subClassOf etd:Evaluation .

etd:Author a owl:Class ;
    rdfs:label "Author"@en ;
    rdfs:comment "ETD proxy class materialised during ontology alignment; used to preserve stable local typing."@en ;
    rdfs:subClassOf aipo:AISystem .

etd:Book a owl:Class ;
    rdfs:label "Book"@en ;
    rdfs:comment "ETD proxy class materialised during ontology alignment; used to preserve stable local typing."@en ;
    rdfs:subClassOf dcat:Dataset .

etd:CodeOfConduct a owl:Class ;
    rdfs:label "Formal organisational or professional code of conduct"@en ;
    rdfs:comment "ETD class representing code of conduct concepts in the semantic knowledge graph."@en ;
    rdfs:subClassOf etd:BestPractice,
        etd:Entity .

etd:ConceptualEntity a owl:Class ;
    rdfs:label "General conceptual entity"@en ;
    rdfs:comment "ETD class representing conceptual entity concepts in the semantic knowledge graph."@en ;
    rdfs:subClassOf etd:Entity .

etd:Data a owl:Class ;
    rdfs:label "Data"@en ;
    rdfs:comment "ETD proxy class materialised during ontology alignment; used to preserve stable local typing."@en ;
    rdfs:subClassOf dcat:Dataset .

etd:DataElement a owl:Class ;
    rdfs:label "Variable, attribute, or field within a dataset"@en ;
    rdfs:comment "ETD class representing data element concepts in the semantic knowledge graph."@en ;
    rdfs:subClassOf etd:Entity .

etd:DataIssue a owl:Class ;
    rdfs:label "Problem with data representation, bias or quality"@en ;
    rdfs:comment "ETD class representing data issue concepts in the semantic knowledge graph."@en ;
    rdfs:subClassOf etd:Entity .

etd:DataType a owl:Class ;
    rdfs:label "Data type"@en ;
    rdfs:comment "ETD class representing data type concepts in the semantic knowledge graph."@en .

etd:DemographicParity a owl:Class ;
    rdfs:label "Demographic parity"@en ;
    rdfs:comment "ETD class representing demographic parity concepts in the semantic knowledge graph."@en ;
    rdfs:subClassOf fmo:DemographicParity,
        etd:EthicalPrinciple .

etd:Employment a owl:Class ;
    rdfs:label "Employment domain"@en ;
    rdfs:comment "ETD class representing employment concepts in the semantic knowledge graph."@en ;
    rdfs:subClassOf etd:Domain,
        vair:EmploymentDomain .

etd:Harm a owl:Class ;
    rdfs:label "Negative consequence or adverse effect"@en ;
    rdfs:comment "A realised (actually occurring, not merely potential) negative consequence experienced by a person, group, system, or organisation, typically as a Risk or Bias materialising in practice."@en ;
    rdfs:subClassOf etd:Entity .

etd:Healthcare a owl:Class ;
    rdfs:label "Healthcare domain"@en ;
    rdfs:comment "ETD class representing healthcare concepts in the semantic knowledge graph."@en ;
    rdfs:subClassOf etd:Domain .

etd:HighRisk a owl:Class ;
    rdfs:label "High-risk AI"@en ;
    rdfs:comment "ETD class representing high risk concepts in the semantic knowledge graph."@en ;
    rdfs:subClassOf etd:Risk,
        vair:HighRiskAI .

etd:Location a owl:Class ;
    rdfs:label "Location"@en ;
    rdfs:comment "ETD class representing location concepts in the semantic knowledge graph."@en .

etd:MachineLearning a owl:Class ;
    rdfs:label "Machine learning process"@en ;
    rdfs:comment "ETD class representing machine learning concepts in the semantic knowledge graph."@en ;
    rdfs:subClassOf etd:AlgorithmicProcess .

etd:Message a owl:Class ;
    rdfs:label "Message"@en ;
    rdfs:comment "ETD class representing message concepts in the semantic knowledge graph."@en ;
    rdfs:subClassOf etd:DiscourseUnit .

etd:Metric a owl:Class ;
    rdfs:label "Metric"@en ;
    rdfs:comment "ETD proxy class materialised during ontology alignment; used to preserve stable local typing."@en ;
    rdfs:subClassOf airo:Metric .

etd:PersonalData a owl:Class ;
    rdfs:label "Personal data"@en ;
    rdfs:comment "ETD class representing personal data concepts in the semantic knowledge graph."@en ;
    rdfs:subClassOf dpv:PersonalData .

etd:Privacy a owl:Class ;
    rdfs:label "Privacy"@en ;
    rdfs:comment "ETD class representing privacy concepts in the semantic knowledge graph."@en ;
    rdfs:subClassOf etd:EthicalPrinciple,
        dpv:Privacy .

etd:ProtectedGroup a owl:Class ;
    rdfs:label "Legally protected demographic group"@en ;
    rdfs:comment "ETD class representing protected group concepts in the semantic knowledge graph."@en ;
    rdfs:subClassOf etd:Entity .

etd:Regulation a owl:Class ;
    rdfs:label "Binding legal instrument (e.g., EU AI Act such as Regulation (EU) 2024/1689)."@en ;
    rdfs:comment "ETD class representing regulation concepts in the semantic knowledge graph."@en ;
    rdfs:subClassOf etd:Entity,
        etd:LegalRequirement .

etd:ResearchStudy a owl:Class ;
    rdfs:label "Research study"@en ;
    rdfs:comment "An empirical or investigative research undertaking (a project, experiment, or study), which may produce its own dataset, analysis, and publications. Use Dataset for the data it produced, Analysis for a specific analytical pass over data, and Publication for a resulting document."@en ;
    rdfs:subClassOf dcat:Dataset,
        etd:ResearchOutput .

etd:Safety a owl:Class ;
    rdfs:label "Safety"@en ;
    rdfs:comment "ETD proxy class materialised during ontology alignment; used to preserve stable local typing."@en ;
    rdfs:subClassOf airo:SafetyRisk .

etd:Software a owl:Class ;
    rdfs:label "Software"@en ;
    rdfs:comment "ETD proxy class materialised during ontology alignment; used to preserve stable local typing."@en ;
    rdfs:subClassOf fmo:Fairness .

etd:SoftwarePackage a owl:Class ;
    rdfs:label "Software package"@en ;
    rdfs:comment "ETD class representing software package concepts in the semantic knowledge graph."@en ;
    rdfs:subClassOf etd:Resource .

etd:SoftwareProduct a owl:Class ;
    rdfs:label "Software product"@en ;
    rdfs:comment "A general-purpose software application, tool, or package used in a workflow, which is not itself an AI/ML system (e.g. a spreadsheet application, a fairness-auditing toolkit). Use AISystem for systems whose core function is AI/ML-driven decision-making or prediction."@en ;
    rdfs:subClassOf schema1:SoftwareApplication,
        etd:System .

etd:Stakeholder a owl:Class ;
    rdfs:label "Actor affected by a system"@en ;
    rdfs:comment "ETD class representing stakeholder concepts in the semantic knowledge graph."@en ;
    rdfs:subClassOf etd:Entity .

etd:Standard a owl:Class ;
    rdfs:label "Published technical or governance standard issued by a standards body (e.g., ISO/IEC, IEEE, NIST)."@en ;
    rdfs:comment "ETD class representing standard concepts in the semantic knowledge graph."@en ;
    rdfs:subClassOf etd:AiGovernanceFramework,
        etd:Entity .

etd:SystemComponent a owl:Class ;
    rdfs:label "Component or subsystem of an AI system"@en ;
    rdfs:comment "ETD class representing system component concepts in the semantic knowledge graph."@en ;
    rdfs:subClassOf etd:Entity .

etd:TimePeriod a owl:Class ;
    rdfs:label "Time period"@en ;
    rdfs:comment "ETD class representing time period concepts in the semantic knowledge graph."@en .

etd:Tool a owl:Class ;
    rdfs:label "Tool"@en ;
    rdfs:comment "ETD proxy class materialised during ontology alignment; used to preserve stable local typing."@en ;
    rdfs:subClassOf aipo:AISystem .

etd:Transparency a owl:Class ;
    rdfs:label "Transparency"@en ;
    rdfs:comment "ETD class representing transparency concepts in the semantic knowledge graph."@en ;
    rdfs:subClassOf etd:EthicalPrinciple,
        aipo:Transparency .

etd:Url a owl:Class ;
    rdfs:label "URL"@en ;
    rdfs:comment "ETD class representing url concepts in the semantic knowledge graph."@en .

etd:affectedBy a owl:ObjectProperty ;
    rdfs:label "affected by"@en ;
    rdfs:comment "ETD object property linking resources using affected by semantics."@en ;
    rdfs:domain etd:Entity ;
    rdfs:range etd:Entity ;
    etd:lifecycleNote "Declared in ontology for compatibility/future modelling; may be unused in current exports."@en ;
    etd:lifecycleStatus "reserved"^^xsd:string .

etd:assertedPredicate a owl:ObjectProperty ;
    rdfs:label "asserted predicate"@en ;
    rdfs:comment "Predicate used by a materialised raw-field triple."@en,
        "Predicate used by the corresponding materialised raw-field triple."@en ;
    rdfs:domain etd:FieldAssertion ;
    rdfs:range rdf:Property ;
    etd:lifecycleStatus "active"^^xsd:string .

etd:assertedValue a rdf:Property ;
    rdfs:label "asserted value"@en ;
    rdfs:comment "Object used by the corresponding materialised raw-field triple."@en,
        "Object value used by a materialised raw-field triple."@en ;
    rdfs:domain etd:FieldAssertion ;
    rdfs:range rdfs:Resource ;
    etd:lifecycleStatus "active"^^xsd:string .

etd:assessedBy a owl:ObjectProperty ;
    rdfs:label "assessed by"@en ;
    rdfs:comment "ETD object property linking resources using assessed by semantics."@en ;
    rdfs:domain etd:RiskAssessment ;
    rdfs:range etd:Person ;
    etd:lifecycleNote "Reserved for structured risk-assessment workflows."@en ;
    etd:lifecycleStatus "reserved"^^xsd:string .

etd:assessesRisk a owl:ObjectProperty ;
    rdfs:label "assesses risk"@en ;
    rdfs:comment "ETD object property linking resources using assesses risk semantics."@en ;
    rdfs:domain etd:RiskAssessment ;
    rdfs:range etd:Risk ;
    etd:lifecycleNote "Reserved for structured risk-assessment workflows."@en ;
    etd:lifecycleStatus "reserved"^^xsd:string .

etd:associatedWith a owl:ObjectProperty ;
    rdfs:label "associated with"@en ;
    rdfs:comment "ETD object property linking resources using associated with semantics."@en ;
    rdfs:domain etd:Entity ;
    rdfs:range etd:Entity ;
    etd:lifecycleNote "Declared in ontology for compatibility/future modelling; may be unused in current exports."@en ;
    etd:lifecycleStatus "reserved"^^xsd:string .

etd:batch_id a owl:DatatypeProperty ;
    rdfs:label "batch id"@en ;
    rdfs:comment "Processing batch identifier."@en ;
    rdfs:domain rdfs:Resource ;
    rdfs:range xsd:string ;
    etd:lifecycleStatus "active"^^xsd:string .

etd:bio a owl:DatatypeProperty ;
    rdfs:label "bio"@en ;
    rdfs:comment "Biographical text."@en,
        "Profile biography text."@en ;
    rdfs:domain etd:Entity ;
    rdfs:range xsd:string ;
    etd:lifecycleNote "Materialised only when sensitive-field materialisation is enabled."@en ;
    etd:lifecycleStatus "conditional"^^xsd:string .

etd:body a owl:DatatypeProperty ;
    rdfs:label "body"@en ;
    rdfs:comment "Body text from source data."@en ;
    rdfs:domain etd:Entity ;
    rdfs:range xsd:string ;
    etd:lifecycleNote "Materialised only when raw source fields are enabled and present."@en ;
    etd:lifecycleStatus "conditional"^^xsd:string .

etd:canonical_predicate a owl:DatatypeProperty ;
    rdfs:label "canonical predicate"@en ;
    rdfs:comment "Canonical ontology predicate chosen by the semantic relation policy."@en ;
    rdfs:domain etd:Relation ;
    rdfs:range xsd:string ;
    etd:lifecycleStatus "active"^^xsd:string .

etd:castVote a owl:ObjectProperty ;
    rdfs:label "cast vote"@en ;
    rdfs:comment "ETD object property linking resources using cast vote semantics."@en ;
    rdfs:domain etd:Person ;
    rdfs:range etd:Vote ;
    etd:lifecycleNote "Declared in ontology for compatibility/future modelling; may be unused in current exports."@en ;
    etd:lifecycleStatus "reserved"^^xsd:string .

etd:causedBy a owl:ObjectProperty ;
    rdfs:label "caused by"@en ;
    rdfs:comment "ETD object property linking resources using caused by semantics."@en ;
    rdfs:domain etd:Entity ;
    rdfs:range etd:Entity ;
    etd:lifecycleNote "Declared in ontology for compatibility/future modelling; may be unused in current exports."@en ;
    etd:lifecycleStatus "reserved"^^xsd:string .

etd:char_end a owl:DatatypeProperty ;
    rdfs:label "character end"@en ;
    rdfs:comment "End character offset for evidence span."@en ;
    rdfs:domain etd:Evidence ;
    rdfs:range xsd:integer ;
    etd:lifecycleStatus "active"^^xsd:string .

etd:char_start a owl:DatatypeProperty ;
    rdfs:label "character start"@en ;
    rdfs:comment "Start character offset for evidence span."@en ;
    rdfs:domain etd:Evidence ;
    rdfs:range xsd:integer ;
    etd:lifecycleStatus "active"^^xsd:string .

etd:chunk_id a owl:DatatypeProperty ;
    rdfs:label "chunk id"@en ;
    rdfs:comment "Stable chunk identifier."@en ;
    rdfs:domain etd:Evidence ;
    rdfs:range xsd:string ;
    etd:lifecycleStatus "active"^^xsd:string .

etd:chunk_index a owl:DatatypeProperty ;
    rdfs:label "chunk index"@en ;
    rdfs:comment "Chunk index of source span; -1 denotes unknown."@en,
        "Chunk index of the source text segment; -1 means unknown/unavailable chunk index."@en ;
    rdfs:domain rdfs:Resource ;
    rdfs:range xsd:integer ;
    etd:lifecycleStatus "active"^^xsd:string .

etd:chunk_index_unknown a owl:DatatypeProperty ;
    rdfs:label "chunk index unknown"@en ;
    rdfs:comment "Flag indicating unknown chunk index provenance."@en ;
    rdfs:domain rdfs:Resource ;
    rdfs:range xsd:boolean ;
    etd:lifecycleStatus "active"^^xsd:string .

etd:chunk_start a owl:DatatypeProperty ;
    rdfs:label "chunk start"@en ;
    rdfs:comment "Chunk start character offset."@en ;
    rdfs:domain rdfs:Resource ;
    rdfs:range xsd:integer ;
    etd:lifecycleStatus "active"^^xsd:string .

etd:chunk_total a owl:DatatypeProperty ;
    rdfs:label "chunk total"@en ;
    rdfs:comment "Total number of chunks in the source discourse."@en ;
    rdfs:domain rdfs:Resource ;
    rdfs:range xsd:integer ;
    etd:lifecycleStatus "active"^^xsd:string .

etd:cites a owl:ObjectProperty ;
    rdfs:label "cites source"@en ;
    rdfs:comment "ETD object property linking resources using cites semantics."@en ;
    rdfs:domain etd:RegulatoryReference ;
    rdfs:range etd:RegulatoryReference ;
    etd:lifecycleNote "Reserved for governance instrument citation workflows."@en ;
    etd:lifecycleStatus "reserved"^^xsd:string .

etd:compliesWith a owl:ObjectProperty ;
    rdfs:label "complies with"@en ;
    rdfs:comment "ETD object property linking resources using complies with semantics."@en ;
    rdfs:domain etd:Entity ;
    rdfs:range etd:Entity ;
    etd:lifecycleNote "Declared in ontology for compatibility/future modelling; may be unused in current exports."@en ;
    etd:lifecycleStatus "reserved"^^xsd:string .

etd:confidence a owl:DatatypeProperty ;
    rdfs:label "confidence"@en ;
    rdfs:comment "Confidence score for an entity/relation/evidence assertion."@en ;
    rdfs:domain etd:Entity ;
    rdfs:range xsd:float ;
    etd:lifecycleStatus "active"^^xsd:string .

etd:containsSubject a owl:ObjectProperty ;
    rdfs:label "contains subject"@en ;
    rdfs:comment "ETD object property linking resources using contains subject semantics."@en ;
    rdfs:domain etd:DiscourseUnit ;
    rdfs:range etd:Entity ;
    etd:lifecycleNote "Declared in ontology for compatibility/future modelling; may be unused in current exports."@en ;
    etd:lifecycleStatus "reserved"^^xsd:string .

etd:contextText a owl:DatatypeProperty ;
    rdfs:label "context text"@en ;
    rdfs:comment "Full sentence/semantic-unit source text needed to interpret an assertion, as distinct from the minimal evidence span."@en ;
    rdfs:domain rdfs:Resource ;
    rdfs:range xsd:string ;
    etd:lifecycleStatus "active"^^xsd:string .

etd:context_char_end a owl:DatatypeProperty ;
    rdfs:label "context character end"@en ;
    rdfs:comment "End character offset of evidenceText within the linked DiscourseUnit's contextText, set only when evidence_alignment_status is not unresolved."@en ;
    rdfs:domain etd:Evidence ;
    rdfs:range xsd:integer ;
    etd:lifecycleStatus "active"^^xsd:string .

etd:context_char_start a owl:DatatypeProperty ;
    rdfs:label "context character start"@en ;
    rdfs:comment "Start character offset of evidenceText within the linked DiscourseUnit's contextText, set only when evidence_alignment_status is not unresolved. Distinct from char_start/end_offset, which reflect the original extraction-time chunk coordinate system."@en ;
    rdfs:domain etd:Evidence ;
    rdfs:range xsd:integer ;
    etd:lifecycleStatus "active"^^xsd:string .

etd:context_source a owl:DatatypeProperty ;
    rdfs:label "context source"@en ;
    rdfs:comment "Extractor/source context."@en ;
    rdfs:domain rdfs:Resource ;
    rdfs:range xsd:string ;
    etd:lifecycleStatus "active"^^xsd:string .

etd:coverage_recovery a owl:DatatypeProperty ;
    rdfs:label "coverage recovery"@en ;
    rdfs:comment "True when an assertion was recovered during semantic coverage recovery."@en ;
    rdfs:domain etd:Relation ;
    rdfs:range xsd:boolean ;
    etd:lifecycleStatus "active"^^xsd:string .

etd:criticizes a owl:ObjectProperty ;
    rdfs:label "criticizes"@en ;
    rdfs:comment "ETD object property linking resources using criticizes semantics."@en ;
    rdfs:domain etd:Entity ;
    rdfs:range etd:Entity ;
    etd:lifecycleNote "Declared in ontology for compatibility/future modelling; may be unused in current exports."@en ;
    etd:lifecycleStatus "reserved"^^xsd:string .

etd:datasetId a owl:DatatypeProperty ;
    rdfs:label "dataset identifier"@en ;
    rdfs:comment "Identifier of the source dataset used for this export/run."@en ;
    rdfs:domain rdfs:Resource ;
    rdfs:range xsd:string ;
    etd:lifecycleStatus "active"^^xsd:string .

etd:dateJoined a owl:DatatypeProperty ;
    rdfs:label "date joined"@en ;
    rdfs:comment "Date joined in source profile."@en,
        "Joined timestamp in source profile data."@en ;
    rdfs:domain etd:Entity ;
    rdfs:range xsd:dateTime ;
    etd:lifecycleNote "Materialised only when raw source fields are enabled and present."@en ;
    etd:lifecycleStatus "conditional"^^xsd:string .

etd:description a owl:DatatypeProperty ;
    rdfs:label "description"@en ;
    rdfs:comment "Description text from source data."@en ;
    rdfs:domain etd:Entity ;
    rdfs:range xsd:string ;
    etd:lifecycleNote "Materialised only when raw source fields are enabled and present."@en ;
    etd:lifecycleStatus "conditional"^^xsd:string .

etd:direction_normalized a owl:DatatypeProperty ;
    rdfs:label "direction normalized"@en ;
    rdfs:comment "Direction normalization outcome recorded by the semantic relation policy."@en ;
    rdfs:domain etd:Relation ;
    rdfs:range xsd:string ;
    etd:lifecycleStatus "active"^^xsd:string .

etd:disagreesWith a owl:ObjectProperty ;
    rdfs:label "disagrees with"@en ;
    rdfs:comment "ETD object property linking resources using disagrees with semantics."@en ;
    rdfs:domain etd:Entity ;
    rdfs:range etd:Entity ;
    etd:lifecycleNote "Declared in ontology for compatibility/future modelling; may be unused in current exports."@en ;
    etd:lifecycleStatus "reserved"^^xsd:string .

etd:discourse_id a owl:DatatypeProperty ;
    rdfs:label "discourse identifier"@en ;
    rdfs:comment "Discourse unit identifier associated with provenance."@en ;
    rdfs:domain rdfs:Resource ;
    rdfs:range rdfs:Literal ;
    etd:lifecycleStatus "active"^^xsd:string .

etd:discourse_mode a owl:DatatypeProperty ;
    rdfs:label "discourse mode"@en ;
    rdfs:comment "Discourse mode preserved during semantic validation, such as declarative or interrogative."@en ;
    rdfs:domain etd:Relation ;
    rdfs:range xsd:string ;
    etd:lifecycleStatus "active"^^xsd:string .

etd:domainCategory a owl:DatatypeProperty ;
    rdfs:label "domain category"@en ;
    rdfs:comment "Domain category from source data."@en ;
    rdfs:domain etd:Entity ;
    rdfs:range xsd:string ;
    etd:lifecycleNote "Materialised only when raw source fields are enabled and present."@en ;
    etd:lifecycleStatus "conditional"^^xsd:string .

etd:domain_range_check a owl:DatatypeProperty ;
    rdfs:label "domain range check"@en ;
    rdfs:comment "Domain/range validation outcome recorded by the semantic relation policy."@en ;
    rdfs:domain etd:Relation ;
    rdfs:range xsd:string ;
    etd:lifecycleStatus "active"^^xsd:string .

etd:end_char a owl:DatatypeProperty ;
    rdfs:label "end character"@en ;
    rdfs:comment "End character offset."@en ;
    rdfs:domain rdfs:Resource ;
    rdfs:range xsd:integer ;
    etd:lifecycleStatus "active"^^xsd:string .

etd:end_offset a owl:DatatypeProperty ;
    rdfs:label "end offset"@en ;
    rdfs:comment "Normalised end offset for evidence span."@en ;
    rdfs:domain etd:Evidence ;
    rdfs:range xsd:integer ;
    etd:lifecycleStatus "active"^^xsd:string .

etd:endorses a owl:ObjectProperty ;
    rdfs:label "endorses"@en ;
    rdfs:comment "ETD object property linking resources using endorses semantics."@en ;
    rdfs:domain etd:Entity ;
    rdfs:range etd:Entity ;
    etd:lifecycleNote "Declared in ontology for compatibility/future modelling; may be unused in current exports."@en ;
    etd:lifecycleStatus "reserved"^^xsd:string .

etd:entailment_check a owl:DatatypeProperty ;
    rdfs:label "entailment check"@en ;
    rdfs:comment "Entailment validation outcome recorded by the semantic relation policy."@en ;
    rdfs:domain etd:Relation ;
    rdfs:range xsd:string ;
    etd:lifecycleStatus "active"^^xsd:string .

etd:entityType rdfs:domain etd:Entity ;
    rdfs:range xsd:string .

etd:entity_role_check a owl:DatatypeProperty ;
    rdfs:label "entity role check"@en ;
    rdfs:comment "Entity-role validation outcome recorded by the semantic relation policy."@en ;
    rdfs:domain etd:Relation ;
    rdfs:range xsd:string ;
    etd:lifecycleStatus "active"^^xsd:string .

etd:epistemic_status a owl:DatatypeProperty ;
    rdfs:label "epistemic status"@en ;
    rdfs:comment "Primary epistemic modality preserved during semantic validation."@en ;
    rdfs:domain etd:Relation ;
    rdfs:range xsd:string ;
    etd:lifecycleStatus "active"^^xsd:string .

etd:evidenceSpan rdfs:domain etd:RiskEvidence ;
    rdfs:range xsd:string .

etd:evidenceText a owl:DatatypeProperty ;
    rdfs:label "evidence text"@en ;
    rdfs:comment "ETD datatype property carrying evidence text metadata values."@en ;
    rdfs:domain etd:Evidence ;
    rdfs:range xsd:string ;
    etd:lifecycleNote "Declared in ontology for compatibility/future modelling; may be unused in current exports."@en ;
    etd:lifecycleStatus "reserved"^^xsd:string .

etd:evidence_alignment_method a owl:DatatypeProperty ;
    rdfs:label "evidence alignment method"@en ;
