etd:discourse_answer.description%7C17 a etd:DiscourseUnit ;
    rdfs:label "DiscourseUnit: answer.description"@en ;
    etd:chunk_id "17:chunk:0"^^xsd:string ;
    etd:chunk_index 0 ;
    etd:chunk_index_unknown false ;
    etd:chunk_total 1 ;
    etd:contextText """I think these systems are really hard to trust because you can't make it explainable.  \r
An example - if you DO say something relevant to the application it can show you 'TA DAA here is where they talk about using excel' for example, but if it's trying to show you that they DON'T talk about something (like they never mention excel) you can't point at nothing!  You can't say here is the section where they DON'T talk about it. \r
\r
So I imagine users would have to either trust the system completely or not at all, and there's not a lot of potential for good balance between human and AI.  \r
\r
I hope that makes sense!"""^^xsd:string ;
    etd:context_source "dataset_answer"^^xsd:string ;
    etd:datasetId "ai_ethics_datasets"^^xsd:string ;
    etd:discourse_id 17 ;
    etd:extractedFrom etd:discourse_answer.description%7C17 ;
    etd:field "answer.description"^^xsd:string ;
    etd:hasSourceEntity <https://alfie-project.eu/etd-hub/entity/answer/answer-17-49d67fb1>,
        <https://alfie-project.eu/etd-hub/entity/person/expert-10-1fba120d>,
        <https://alfie-project.eu/etd-hub/entity/person/expert-35-7aee2084>,
        <https://alfie-project.eu/etd-hub/entity/person/expert-36-33b967cd>,
        <https://alfie-project.eu/etd-hub/entity/person/expert-4-c84647f9>,
        <https://alfie-project.eu/etd-hub/entity/person/expert-5-36a8e629>,
        <https://alfie-project.eu/etd-hub/entity/question/question-16-a1cc6531>,
        <https://alfie-project.eu/etd-hub/entity/theme/theme-10-db7e2802> ;
    etd:runId "run-b0eafdda0235eb48"^^xsd:string ;
    etd:source "structural"^^xsd:string ;
    etd:source_doc_id "17"^^xsd:string .

etd:discourse_answer.description%7C18 a etd:DiscourseUnit ;
    rdfs:label "DiscourseUnit: answer.description"@en ;
    etd:chunk_id "18:chunk:0"^^xsd:string ;
    etd:chunk_index 0 ;
    etd:chunk_index_unknown false ;
    etd:chunk_total 1 ;
    etd:contextText "Yeah this is a really important consideration when you don't have a 'gold standard' label, like 'death' but something more objective."^^xsd:string ;
    etd:context_source "dataset_answer"^^xsd:string ;
    etd:datasetId "ai_ethics_datasets"^^xsd:string ;
    etd:discourse_id 18 ;
    etd:extractedFrom etd:discourse_answer.description%7C18 ;
    etd:field "answer.description"^^xsd:string ;
    etd:hasSourceEntity <https://alfie-project.eu/etd-hub/entity/answer/answer-18-798c9dbe>,
        <https://alfie-project.eu/etd-hub/entity/person/expert-10-1fba120d>,
        <https://alfie-project.eu/etd-hub/entity/person/expert-4-c84647f9>,
        <https://alfie-project.eu/etd-hub/entity/person/expert-46-77fe0fcb>,
        <https://alfie-project.eu/etd-hub/entity/person/expert-47-dbc100d9>,
        <https://alfie-project.eu/etd-hub/entity/person/expert-5-36a8e629>,
        <https://alfie-project.eu/etd-hub/entity/question/question-18-7ef11331>,
        <https://alfie-project.eu/etd-hub/entity/theme/theme-12-2a17af94> ;
    etd:runId "run-b0eafdda0235eb48"^^xsd:string ;
    etd:source "structural"^^xsd:string ;
