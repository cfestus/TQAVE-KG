etd:discourse_answer.description%7C25 a etd:DiscourseUnit ;
    rdfs:label "DiscourseUnit: answer.description"@en ;
    etd:chunk_id "25:chunk:0"^^xsd:string ;
    etd:chunk_index 0 ;
    etd:chunk_index_unknown false ;
    etd:chunk_total 1 ;
    etd:contextText """Also another thought - for an employer maybe something better is just to flag somebody who definitely *wont* work out at the job due to some very specific criteria such as a conviction which will cause something like a DBS or Background check to fail, which is a requirement for the job.\r
\r
In this case you could definitely say the model is completely ethical because it is just searching for a practically disqualifying criteria and marking the user as unsuitable because it is genuinely impossible.\r
\r
In this case, you probably have to tackle preventing misuse - i.e. somebody applying the model to a criteria which is not practically disqualifying but preferentially disqualifying.\r
\r
Also I suppose this then ends up being something different as a tool - I'm just thinking out loud."""^^xsd:string ;
    etd:context_source "dataset_answer"^^xsd:string ;
    etd:datasetId "ai_ethics_datasets"^^xsd:string ;
    etd:discourse_id 25 ;
    etd:extractedFrom etd:discourse_answer.description%7C25 ;
    etd:field "answer.description"^^xsd:string ;
    etd:hasSourceEntity <https://alfie-project.eu/etd-hub/entity/answer/answer-25-040bd5d0>,
        <https://alfie-project.eu/etd-hub/entity/person/expert-10-1fba120d>,
        <https://alfie-project.eu/etd-hub/entity/person/expert-4-c84647f9>,
        <https://alfie-project.eu/etd-hub/entity/person/expert-5-36a8e629>,
        <https://alfie-project.eu/etd-hub/entity/person/expert-9-dc2377f4>,
        <https://alfie-project.eu/etd-hub/entity/question/question-17-febdd494>,
        <https://alfie-project.eu/etd-hub/entity/theme/theme-10-db7e2802> ;
    etd:runId "run-b0eafdda0235eb48"^^xsd:string ;
    etd:source "structural"^^xsd:string ;
    etd:source_doc_id "25"^^xsd:string .

etd:discourse_theme.description%7C17 a etd:DiscourseUnit ;
    rdfs:label "DiscourseUnit: theme.description"@en ;
    etd:chunk_id "17:chunk:0"^^xsd:string ;
    etd:chunk_index 0 ;
    etd:chunk_index_unknown false ;
    etd:chunk_total 1 ;
    etd:contextText """**Domain**: E-commerce/Recommendation Systems  \r
**Description**: Online marketplace recommendation algorithms show bias in product suggestions, affecting business opportunities for minority-owned businesses and perpetuating stereotypes.\r
\r
**Ethical Challenges**:\r
\r
* **Economic Opportunity Bias**: Reduced visibility for minority-owned businesses  \r
* **Stereotype Reinforcement**: Algorithms that reinforce gender and racial stereotypes in product recommendations  \r
* **Filter Bubbles**: Creation of echo chambers that limit exposure to diverse products and sellers  \r
* **Price Discrimination**: Dynamic pricing that varies based on user demographics\r
\r
**Public Datasets**:\r
\r
* **Amazon Product Review Dataset**: Large-scale product reviews with potential demographic indicators  \r
* **URL**: https://nijianmo.github.io/amazon/index.html  \r
* **Yelp Open Dataset**: Business reviews and ratings with geographic and demographic patterns  \r
* **URL**: https://www.yelp.com/dataset  \r
* **RecSys Challenge Datasets**: Annual competition datasets for recommendation systems  \r
* **URL**: https://recsys.acm.org/recsys-challenge/"""^^xsd:string ;
    etd:context_source "dataset_theme"^^xsd:string ;
    etd:datasetId "ai_ethics_datasets"^^xsd:string ;
    etd:discourse_id 17 ;
    etd:extractedFrom etd:discourse_theme.description%7C17 ;
    etd:field "theme.description"^^xsd:string ;
