etd:discourse_question.body%7C20 a etd:DiscourseUnit ;
    rdfs:label "DiscourseUnit: question.body"@en ;
    etd:chunk_id "20:chunk:0"^^xsd:string ;
    etd:chunk_index 0 ;
    etd:chunk_index_unknown false ;
    etd:chunk_total 1 ;
    etd:contextText """AI could be dangerous because:\r
1) AI systems can have real-world impacts (e.g., biased hiring, facial recognition misuse).\r
2) Flawed audits may overlook systemic issues like discrimination, data leakage, or poor model explainability.\r
\r
What I am asking to explore is:\r
A) How to build robust auditing processes (technical and ethical).\r
B) Who should conduct audits (internal teams? external bodies? community orgs?).\r
C) How to institutionalize ethical review so it’s part of the product lifecycle, not an afterthought.\r
D) How to ensure accountability when audit findings are ignored or covered up"""^^xsd:string ;
    etd:context_source "dataset_question"^^xsd:string ;
    etd:datasetId "ai_ethics_datasets"^^xsd:string ;
    etd:discourse_id 20 ;
    etd:extractedFrom etd:discourse_question.body%7C20 ;
    etd:field "question.body"^^xsd:string ;
    etd:hasSourceEntity <https://alfie-project.eu/etd-hub/entity/person/expert-4-c84647f9>,
        <https://alfie-project.eu/etd-hub/entity/person/expert-48-80c328cc>,
        <https://alfie-project.eu/etd-hub/entity/person/expert-49-c198e05d>,
        <https://alfie-project.eu/etd-hub/entity/person/expert-5-36a8e629>,
        <https://alfie-project.eu/etd-hub/entity/question/question-14-b569e41b>,
        <https://alfie-project.eu/etd-hub/entity/question/question-20-e5df48f4>,
        <https://alfie-project.eu/etd-hub/entity/theme/theme-6-2ed5ac4a>,
        <https://alfie-project.eu/etd-hub/entity/theme/theme-7-d2d078c8> ;
    etd:runId "run-b0eafdda0235eb48"^^xsd:string ;
    etd:source "structural"^^xsd:string ;
