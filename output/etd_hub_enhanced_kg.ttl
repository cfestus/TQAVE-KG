etd:discourse_question.body%7C14 a etd:DiscourseUnit ;
    rdfs:label "DiscourseUnit: question.body"@en ;
    etd:chunk_id "14:chunk:0"^^xsd:string ;
    etd:chunk_index 0 ;
    etd:chunk_index_unknown false ;
    etd:chunk_total 1 ;
    etd:contextText "Can a predictive system used in life-altering decisions ever be considered 'fair' if its inner workings are proprietary and its outcomes show systemic racial disparities, even when trained on 'real-world' data?"^^xsd:string ;
    etd:context_source "dataset_question"^^xsd:string ;
    etd:datasetId "ai_ethics_datasets"^^xsd:string ;
    etd:discourse_id 14 ;
    etd:extractedFrom etd:discourse_question.body%7C14 ;
    etd:field "question.body"^^xsd:string ;
    etd:hasSourceEntity <https://alfie-project.eu/etd-hub/entity/person/expert-10-1fba120d>,
        <https://alfie-project.eu/etd-hub/entity/person/expert-4-c84647f9>,
        <https://alfie-project.eu/etd-hub/entity/person/expert-5-36a8e629>,
        <https://alfie-project.eu/etd-hub/entity/person/expert-9-dc2377f4>,
        <https://alfie-project.eu/etd-hub/entity/question/question-14-b569e41b>,
        <https://alfie-project.eu/etd-hub/entity/question/question-17-febdd494>,
        <https://alfie-project.eu/etd-hub/entity/theme/theme-10-db7e2802>,
        <https://alfie-project.eu/etd-hub/entity/theme/theme-6-2ed5ac4a> ;
    etd:runId "run-b0eafdda0235eb48"^^xsd:string ;
    etd:source "structural"^^xsd:string ;
    etd:source_doc_id "14"^^xsd:string .

etd:discourse_question.body%7C18 a etd:DiscourseUnit ;
    rdfs:label "DiscourseUnit: question.body"@en ;
    etd:chunk_id "18:chunk:0"^^xsd:string ;
    etd:chunk_index 0 ;
    etd:chunk_index_unknown false ;
    etd:chunk_total 1 ;
    etd:contextText "To what extent do a persons own biases 'contaminate' the fairness of a dataset during the labelling process? Are such ethical issues an inherent problem - i.e. is it ever possible to separate a persons own perspectives and biases from this process?"^^xsd:string ;
    etd:context_source "dataset_question"^^xsd:string ;
    etd:datasetId "ai_ethics_datasets"^^xsd:string ;
    etd:discourse_id 18 ;
    etd:extractedFrom etd:discourse_question.body%7C18 ;
