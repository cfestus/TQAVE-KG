etd:Organization a owl:Class ;
    rdfs:label "Organisation"@en ;
    rdfs:comment "A formally identifiable organisation, company, agency, or institution acting as a collective entity (e.g. a company, regulator, research lab, or university). Aligned with schema:Organization."@en ;
    rdfs:subClassOf schema1:Organization,
        prov:Agent,
        etd:Entity .

etd:Outcome a owl:Class ;
    rdfs:label "Observed or expected result; may be positive or negative."@en ;
    rdfs:comment "A neutral, general term for any observed or expected result of a process, decision, or intervention, which may be positive, negative, or mixed. Use Harm specifically when the result is negative and its adverse character is the salient fact being asserted; use Outcome when valence is not the point being made or the result is not purely negative."@en ;
    rdfs:subClassOf etd:Entity .

etd:Proposition a owl:Class ;
    rdfs:label "Proposition"@en ;
    rdfs:comment "The semantic content/state expressed by a single source semantic unit, distinct from the DiscourseUnit (source text/provenance) and Relation (reified assertion) that may derive from it; used as the antecedent for discourse-level (propositional) deixis such as a sentence-initial 'This'/'That'/'It' referring back to a preceding statement rather than to a named entity."@en ;
    rdfs:subClassOf etd:Entity .

etd:RacialBias a owl:Class ;
