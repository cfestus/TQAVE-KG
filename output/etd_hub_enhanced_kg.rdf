  <rdf:Description rdf:about="https://alfie-project.eu/etd-hub#Outcome">
    <rdfs:comment xml:lang="en">A neutral, general term for any observed or expected result of a process, decision, or intervention, which may be positive, negative, or mixed. Use Harm specifically when the result is negative and its adverse character is the salient fact being asserted; use Outcome when valence is not the point being made or the result is not purely negative.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Observed or expected result; may be positive or negative.</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://alfie-project.eu/etd-hub#Entity"/>
  </rdf:Description>
