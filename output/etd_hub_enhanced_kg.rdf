  <rdf:Description rdf:about="https://alfie-project.eu/etd-hub#ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:title xml:lang="en">ETD-Hub Semantic Knowledge Graph Ontology</dcterms:title>
    <dcterms:description xml:lang="en">Ontology for generating a discourse-driven AI ethics semantic knowledge graph from Q&amp;A datasets, supporting reified relations with evidence, provenance metadata, and vote-based endorsements.</dcterms:description>
    <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">0.1.0</owl:versionInfo>
    <owl:imports rdf:resource="https://w3id.org/aipo"/>
    <owl:imports rdf:resource="https://w3id.org/airo"/>
    <owl:imports rdf:resource="https://w3id.org/dpv"/>
    <owl:imports rdf:resource="https://w3id.org/vair"/>
    <owl:imports rdf:resource="http://purl.org/fairness-metrics-ontology/"/>
    <owl:imports rdf:resource="http://www.w3.org/ns/dcat"/>
    <owl:imports rdf:resource="http://www.w3.org/ns/prov-o"/>
    <owl:imports rdf:resource="http://www.w3.org/2004/02/skos/core"/>
    <owl:imports rdf:resource="http://xmlns.com/foaf/0.1/"/>
    <owl:imports rdf:resource="http://www.w3.org/ns/org#"/>
    <owl:imports rdf:resource="http://rdfs.org/sioc/ns#"/>
    <owl:imports rdf:resource="http://schema.org/"/>
    <owl:imports rdf:resource="http://purl.org/ontology/bibo/"/>
    <owl:imports rdf:resource="http://purl.org/dc/terms/"/>
  </rdf:Description>
