  <rdf:Description rdf:about="https://alfie-project.eu/etd-hub#PopulationGroup">
    <rdfs:comment xml:lang="en">Any group of people considered collectively as the subject or object of a discourse claim (e.g. 'applicants', 'end-users', 'recruiters'). Use DemographicGroup specifically when the group is defined by a shared demographic or legally/ethically salient characteristic (race, gender, age, disability, etc.); use PopulationGroup for broader or role-defined groupings that are not demographic categories per se. Do not use for a finding, statistic, or clause ABOUT a group -- that remains a literal relation value, not a group entity in its own right.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Population group</rdfs:label>
