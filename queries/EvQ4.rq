# Evaluation question
# Which answers received vote-based support, and which experts cast the corresponding votes?

PREFIX etd: <https://alfie-project.eu/etd-hub#>

SELECT DISTINCT ?answer ?vote ?expert ?voteValue ?polarity
WHERE {
    ?answer a etd:Answer ;
            etd:receivesVote ?vote .

    ?vote a etd:Vote ;
          etd:castBy ?expert .

    OPTIONAL {
        ?vote etd:voteValue ?voteValue .
    }

    OPTIONAL {
        ?vote etd:polarity ?polarity .
    }
}
ORDER BY ?answer ?vote