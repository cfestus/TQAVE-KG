# Evaluation question
# Can the inference status of semantic relations be retrieved, distinguishing inferred from non-inferred relations?

PREFIX etd: <https://alfie-project.eu/etd-hub#>

SELECT ?inferred
       (COUNT(DISTINCT ?relation) AS ?relations)
WHERE {
    ?relation a etd:Relation ;
              etd:relation_kind ?kind ;
              etd:isInferred ?inferred .

    FILTER(STR(?kind) = "extracted_semantic")
}
GROUP BY ?inferred
ORDER BY ?inferred