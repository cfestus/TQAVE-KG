# Evaluation question
# Which experts contributed answers, questions, themes, or vote signals associated with a given part of the discourse?

PREFIX etd: <https://alfie-project.eu/etd-hub#>

SELECT DISTINCT ?expert ?contributionType ?item
WHERE {
    {
        ?item etd:authoredBy ?expert .
        BIND("answer" AS ?contributionType)
    }
    UNION
    {
        ?item etd:askedBy ?expert .
        BIND("question" AS ?contributionType)
    }
    UNION
    {
        ?item etd:createdBy ?expert .
        BIND("theme" AS ?contributionType)
    }
    UNION
    {
        ?item etd:castBy ?expert .
        BIND("vote" AS ?contributionType)
    }
}
ORDER BY ?expert ?contributionType ?item