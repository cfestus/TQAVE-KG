# Evaluation question
# Can an extracted relation be traced to its source entity, source field, evidence record, and associated discourse context?

PREFIX etd: <https://alfie-project.eu/etd-hub#>

SELECT ?relation
       ?field
       ?evidence
       ?evidenceText
       ?relationDiscourse
       ?evidenceDiscourse
       (GROUP_CONCAT(
           DISTINCT STR(?sourceEntity);
           separator=" | "
        ) AS ?sourceEntities)
WHERE {
    ?relation a etd:Relation ;
              etd:relation_kind ?kind ;
              etd:hasSourceEntity ?sourceEntity ;
              etd:field ?field ;
              etd:hasEvidence ?evidence ;
              etd:extractedFrom ?relationDiscourse .

    FILTER(STR(?kind) = "extracted_semantic")

    ?evidence etd:extractedFrom ?evidenceDiscourse .

    OPTIONAL {
        ?evidence etd:evidenceText ?evidenceText .
    }
}
GROUP BY
    ?relation
    ?field
    ?evidence
    ?evidenceText
    ?relationDiscourse
    ?evidenceDiscourse
ORDER BY ?relation ?evidence