# Copy this file to key/.env (or any path and point DOTENV_PATH/ENV_FILE at it)
# and fill in real values. Never commit the populated file — key/.env is
# git-ignored (see .gitignore) and archive/ deliberately does not contain it.
#
# Only variables actually read by config.py are listed below.

# --- Required for the default pipeline run (LLM-only extraction) ---
OPENAI_API_KEY=

# --- Optional: project namespaces (defaults shown are the paper's namespaces) ---
# ETD_NS=https://alfie-project.eu/etd-hub#
# ONTO_NS=https://alfie-project.eu/ontology#

# --- Optional: Wikidata entity-linking endpoint (default shown) ---
# WIKIDATA_SPARQL_ENDPOINT=https://query.wikidata.org/sparql

# --- Optional: GraphDB upload (only read if USE_GRAPHDB_UPLOAD=true) ---
# USE_GRAPHDB_UPLOAD=false
# GRAPHDB_SERVER_URL=
# GRAPHDB_REPO_NAME=
# GRAPHDB_USERNAME=
# GRAPHDB_PASSWORD=
# GRAPHDB_USE_AUTH=true

# --- Optional: pipeline strictness / quality-gate toggles (defaults shown) ---
# STRICT_PREDICATE_INVENTORY=false
# STRICT_RELATION_BACKBONE=false
# STRICT_ETD_PROPERTY_REGISTRY=true
# FAIL_ON_SHACL_VIOLATIONS=false
# FAIL_ON_UPLOAD_FAILURE=false
# PRUNE_ISOLATED_ENTITIES=true
# MATERIALIZE_RAW_FIELDS=true
# MATERIALIZE_SENSITIVE_FIELDS=false
# STRICT_PROVENANCE_GROUNDING=true
